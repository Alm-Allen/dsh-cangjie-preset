{
  "name": "@alm-allen/dsh-cangjie-preset",
  "version": "2026.10.17",
  "description": "仓颉模式（cangjie）：把 DeepSeek Harness 的原生 PTC 模式汉化——系统提示词与 run_code 工具提示词全部中文，模型以中文思维链工作；按 Loader 行 id 覆盖 preset-ptc，不新增预设条目。",
  "type": "module",
  "license": "MIT",
  "main": "./plugins/cangjie-zh.mjs",
  "exports": {
    ".": "./plugins/cangjie-zh.mjs",
    "./cangjie-zh": "./plugins/cangjie-zh.mjs",
    "./self-test": "./plugins/self-test.mjs",
    "./audit-coverage": "./plugins/audit-coverage.mjs",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "plugins",
    "cordis.patch.yml",
    "locale",
    "README.md",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Alm-Allen/dsh-cangjie-preset.git"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "agent-preset",
    "cangjie"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  }
}
